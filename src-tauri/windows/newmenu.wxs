<?xml version="1.0" encoding="utf-8"?>
<!-- md-reader: MSI always adds "New > Markdown" to the right-click menu (no UI to opt out in MSI). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Component Id="MdShellNew" Guid="4E2B7C1A-6F0D-4B8E-9C3A-2D5F8A1E7B64">
        <RegistryKey Root="HKCR" Key=".md\MarkdownReader.md\ShellNew">
          <RegistryValue Name="NullFile" Type="string" Value="" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
